{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VeloxFetch",
  "version": "2.0.0",
  "identifier": "app.velox.fetch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "VeloxFetch",
        "visible": false,
        "backgroundColor": "#070d1d",
        "width": 1360,
        "height": 860,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: blob:",
        "media-src": "velox-preview: http://velox-preview.localhost",
        "style-src": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420",
        "img-src": "'self' asset: blob:",
        "media-src": "velox-preview: http://velox-preview.localhost",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "postInstallScript": "packaging/postinst.sh",
        "postRemoveScript": "packaging/postrm.sh"
      },
      "rpm": {
        "postInstallScript": "packaging/postinst.sh",
        "postRemoveScript": "packaging/postrm.sh"
      }
    }
  }
}
