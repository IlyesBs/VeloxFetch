{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "download-window",
  "description": "A single-download detail window: inspect and control one download, no creating/deleting.",
  "windows": [
    "download-detail"
  ],
  "permissions": [
    "allow-get-download",
    "allow-get-download-detail",
    "allow-pause-download",
    "allow-resume-download",
    "allow-cancel-download",
    "allow-retry-download",
    "allow-set-priority",
    "allow-set-speed-limit",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
