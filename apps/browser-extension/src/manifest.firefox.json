{
  "manifest_version": 3,
  "name": "VeloxFetch",
  "version": "1.0.0",
  "description": "Send downloads and videos to the VeloxFetch download manager.",
  "browser_specific_settings": {
    "gecko": {
      "id": "velox-fetch@velox.app",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "VeloxFetch",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png"
    }
  },
  "background": {
    "scripts": [
      "lib/validate.js",
      "lib/media.js",
      "background.js"
    ]
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
